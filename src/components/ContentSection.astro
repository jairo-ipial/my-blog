---
import { localeFromPath, translator } from '../i18n/utils';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
interface Props {
  id: string;
  title: string;
  backToTop?: string;
}

const { id, title, backToTop } = Astro.props;
---

<section aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  <slot />
  {backToTop && <a class="back-to-top" href={backToTop}>{t("Back to top")} <span aria-hidden="true">↑</span></a>}
</section>

<style>
  section {
    border-top: 1px solid rgb(var(--gray-light));
    padding-top: 36px;
    margin-top: 36px;
  }
  h2 {
    font-size: 1.45rem;
    margin: 0 0 28px;
    scroll-margin-top: 24px;
  }
  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 24px;
    font-size: .85rem;
    text-underline-offset: 4px;
  }
  @media print {
    .back-to-top { display: none; }
    section { margin-top: 20px; padding-top: 20px; }
    h2 { font-size: 14pt; margin-bottom: 16px; break-after: avoid; }
  }
</style>

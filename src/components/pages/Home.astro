---
import { localeFromPath, translator, localizedPath } from '../../i18n/utils';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
import { getCollection } from 'astro:content';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import PostTags from '../PostTags.astro';
import ContentSection from '../ContentSection.astro';
import FormattedDate from '../FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`${t("Engineering notes from the field")} | ${SITE_TITLE}`}
			description={t("Experiments, decisions, and lessons from building software that needs to work beyond the demo.")}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section aria-labelledby="intro-title">
				<h1 id="intro-title">{t("Engineering notes from the field")}</h1>
				<p class="lead">{t("Experiments, decisions, and lessons from building software that needs to work beyond the demo.")}</p>
				<p>{t("I’m Jairo Ipial, a software engineer and technical leader based in Bogotá. I work across payments, cloud platforms, and production systems. This is where I document what I build, what breaks, and what I learn.")}</p>
				<nav class="actions" aria-label={t("Explore the site")}>
					<a class="button" href="/blog/">{t("Explore the articles")}</a>
					<a href={localizedPath("/about/", locale)}>{t("About me")}</a>
					<a href={localizedPath("/cv/", locale)}>{t("View my CV")}</a>
				</nav>
			</section>

			<ContentSection id="latest-title" title={t("Latest articles")}>
				<p>{t("Hands-on experiences with software engineering, infrastructure, and applied AI—with the tradeoffs and results behind each project.")}</p>
				<ul class="latest-articles">
					{latestPosts.map((post) => (
						<li lang="en">
							<p class="date"><FormattedDate date={post.data.pubDate} /></p>
							<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
							<PostTags tags={post.data.tags} />
						</li>
					))}
				</ul>
			</ContentSection>

			<ContentSection id="exploring-title" title={t("Currently exploring")}>
				<h3>{t("Open-source AI for small-business advertising")}</h3>
				<p>{t("From setting up rented GPUs to generating video and evaluating commercial quality, I’m exploring what it takes to turn AI experiments into a useful service.")}</p>
				<p><strong><a href="/blog/configure-runpod-instance/">{t("Read the project story")}</a></strong></p>
			</ContentSection>

			<ContentSection id="topics-title" title={t("What you’ll find here")}>
				<ul class="topics">
					<li><strong>{t("Software engineering:")}</strong> {t("APIs, distributed systems, and maintainable applications.")}</li>
					<li><strong>{t("Cloud and DevOps:")}</strong> {t("reproducible environments, containers, and delivery workflows.")}</li>
					<li><strong>{t("Production reliability:")}</strong> {t("troubleshooting, observability, and lessons from operating critical systems.")}</li>
					<li><strong>{t("Applied AI:")}</strong> {t("practical experiments, performance measurements, and limitations.")}</li>
				</ul>
			</ContentSection>

			<ContentSection id="contact-title" title={t("Have something in mind?")}>
				<p>{t("I’m open to conversations about engineering leadership, software projects, and practical uses of AI.")}</p>
				<a class="button" href="mailto:jairo.ipial@gmail.com">{t("Get in touch")}</a>
			</ContentSection>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); letter-spacing: -.035em; }
	h3 { font-size: 1.3rem; line-height: 1.4; }
	.lead { font-size: 1.2em; color: rgb(var(--black)); }
	.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 28px; }
	.actions > a:not(.button) { font-weight: 700; }
	.latest-articles { list-style: none; padding: 0; margin: 0; }
	.latest-articles li { padding: 24px 0; border-bottom: 1px solid rgb(var(--gray-light)); }
	.latest-articles li:last-child { border-bottom: none; padding-bottom: 0; }
	.latest-articles p:last-child { margin-bottom: 0; }
	.date { margin: 0 0 8px; font-size: .85rem; color: rgb(var(--gray)); }
	.topics { padding-left: 24px; }
	.topics li + li { margin-top: 12px; }
	a { text-underline-offset: 4px; }
</style>

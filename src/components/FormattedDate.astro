---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString('en-us', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		// Frontmatter calendar dates are parsed at UTC midnight.
		// Keep that calendar day when the server runs west of UTC.
		timeZone: 'UTC',
	})}
</time>

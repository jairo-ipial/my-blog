---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostTags from '../components/PostTags.astro';
import ContentSection from '../components/ContentSection.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Engineering notes from the field | ${SITE_TITLE}`}
			description="Experiments, decisions, and lessons from building software that needs to work beyond the demo."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section aria-labelledby="intro-title">
				<h1 id="intro-title">Engineering notes from the field</h1>
				<p class="lead">Experiments, decisions, and lessons from building software that needs to work beyond the demo.</p>
				<p>I’m Jairo Ipial, a software engineer and technical leader based in Bogotá. I work across payments, cloud platforms, and production systems. This is where I document what I build, what breaks, and what I learn.</p>
				<nav class="actions" aria-label="Explore the site">
					<a class="button" href="/blog/">Explore the articles</a>
					<a href="/about/">About me</a>
					<a href="/cv/">View my CV</a>
				</nav>
			</section>

			<ContentSection id="latest-title" title="Latest articles">
				<p>Hands-on experiences with software engineering, infrastructure, and applied AI—with the tradeoffs and results behind each project.</p>
				<ul class="latest-articles">
					{latestPosts.map((post) => (
						<li>
							<p class="date"><FormattedDate date={post.data.pubDate} /></p>
							<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
							<PostTags tags={post.data.tags} />
						</li>
					))}
				</ul>
			</ContentSection>

			<ContentSection id="exploring-title" title="Currently exploring">
				<h3>Open-source AI for small-business advertising</h3>
				<p>From setting up rented GPUs to generating video and evaluating commercial quality, I’m exploring what it takes to turn AI experiments into a useful service.</p>
				<p><strong><a href="/blog/configure-runpod-instance/">Read the project story</a></strong></p>
			</ContentSection>

			<ContentSection id="topics-title" title="What you’ll find here">
				<ul class="topics">
					<li><strong>Software engineering:</strong> APIs, distributed systems, and maintainable applications.</li>
					<li><strong>Cloud and DevOps:</strong> reproducible environments, containers, and delivery workflows.</li>
					<li><strong>Production reliability:</strong> troubleshooting, observability, and lessons from operating critical systems.</li>
					<li><strong>Applied AI:</strong> practical experiments, performance measurements, and limitations.</li>
				</ul>
			</ContentSection>

			<ContentSection id="contact-title" title="Have something in mind?">
				<p>I’m open to conversations about engineering leadership, software projects, and practical uses of AI.</p>
				<a class="button" href="mailto:jairo.ipial@gmail.com">Get in touch</a>
			</ContentSection>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); letter-spacing: -.035em; }
	h3 { font-size: 1.3rem; line-height: 1.4; }
	.lead { font-size: 1.2em; color: rgb(var(--black)); }
	.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 28px; }
	.actions > a:not(.button) { font-weight: 700; }
	.latest-articles { list-style: none; padding: 0; margin: 0; }
	.latest-articles li { padding: 24px 0; border-bottom: 1px solid rgb(var(--gray-light)); }
	.latest-articles li:last-child { border-bottom: none; padding-bottom: 0; }
	.latest-articles p:last-child { margin-bottom: 0; }
	.date { margin: 0 0 8px; font-size: .85rem; color: rgb(var(--gray)); }
	.topics { padding-left: 24px; }
	.topics li + li { margin-top: 12px; }
	a { text-underline-offset: 4px; }
</style>

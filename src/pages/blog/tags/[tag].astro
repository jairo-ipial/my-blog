---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import PostTags from '../../../components/PostTags.astro';
import { tagSlug } from '../../../utils/tags';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const tags = new Map(posts.flatMap((post) => post.data.tags.map((tag) => [tagSlug(tag), tag] as const)));
  return [...tags].map(([slug, tag]) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((post) => post.data.tags.some((value) => tagSlug(value) === slug)) },
  }));
}
interface Props { tag: string; posts: CollectionEntry<'blog'>[]; }
const { tag, posts } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`${tag} articles | ${SITE_TITLE}`} description={`Read ${SITE_TITLE}’s articles tagged ${tag}.`} /></head>
  <body>
    <Header />
    <main>
      <a href="/blog/">← All articles</a>
      <h1>Articles tagged “{tag}”</h1>
      <p>{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
      <ul>
        {posts.map((post) => (
          <li>
            <p class="date"><FormattedDate date={post.data.pubDate} /></p>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <PostTags tags={post.data.tags} />
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
<style>
  h1 { margin-top: 24px; font-size: clamp(2rem, 6vw, 3rem); }
  h2 { font-size: 1.4rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid rgb(var(--gray-light)); padding: 24px 0; }
  .date { color: rgb(var(--gray)); font-size: .85rem; margin-top: 0; }
</style>

{
  "name": "my-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:mobile": "playwright test --config tests/playwright.config.ts",
    "test:mobile:report": "playwright show-report tests/report",
    "check": "astro check",
    "check:types": "tsc --noEmit",
    "test:coverage": "node tests/coverage.mjs",
    "validate": "npm run check && npm run check:types && npm run test:mobile",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test:i18n": "playwright test --config tests/playwright.config.ts i18n.spec.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  }
}
